# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Google Gemini API (server-side judge only; never exposed to browser)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# AES-256-GCM encryption secret for stored agent credentials (required in production)
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHAR_SECRET"

# PostgreSQL / Cloud SQL Runtime Connection
SQL_HOST="127.0.0.1"
SQL_DB_NAME="audit_my_agent"
SQL_USER="postgres"
SQL_PASSWORD="REPLACE_WITH_DB_PASSWORD"

# PostgreSQL Admin Credentials (used by Drizzle Kit schema migrations)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="REPLACE_WITH_ADMIN_PASSWORD"

# Firebase Auth (Server-side token verification & optional client env overrides)
# Alternatively copy firebase-applet-config.example.json -> firebase-applet-config.json
FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_OAUTH_CLIENT_ID=""
